# Скопируй в .env и заполни. .env в .gitignore — НИКОГДА не коммитится.

# BingX (VST demo: ключи выпускаются в личном кабинете BingX; sandbox=true в settings.yaml)
BINGX_API_KEY=
BINGX_API_SECRET=

# Telegram-бот Hermes: чат, команды, вопросы (создать через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# СИГНАЛЬНЫЙ бот: карточки сетапов + рабочие кнопки (ВТОРОЙ бот от @BotFather;
# его getUpdates принадлежит демону — Hermes глотает чужие callback'и)
TELEGRAM_SIGNALS_BOT_TOKEN=

# Опционально: CoinMarketCap free tier (Sentinel, макро-контекст)
CMC_API_KEY=

# Опционально: last30days social scraper (Фаза 3+)
# SCRAPECREATORS_API_KEY=
