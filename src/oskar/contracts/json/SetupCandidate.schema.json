{
  "$defs": {
    "CandleFrame": {
      "additionalProperties": false,
      "description": "Разметка последней закрытой свечи одного ТФ (detect/candles.py).",
      "properties": {
        "at_extreme": {
          "anyOf": [
            {
              "enum": [
                "low",
                "high",
                "both"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Extreme"
        },
        "bar_ts": {
          "title": "Bar Ts",
          "type": "integer"
        },
        "patterns": {
          "items": {
            "enum": [
              "doji",
              "dragonfly_doji",
              "gravestone_doji",
              "pin_bar_bull",
              "pin_bar_bear",
              "engulfing_bull",
              "engulfing_bear",
              "inside_bar",
              "harami_bull",
              "harami_bear",
              "morning_star",
              "evening_star",
              "marubozu_bull",
              "marubozu_bear"
            ],
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        },
        "prior_move_atr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prior Move Atr"
        }
      },
      "required": [
        "bar_ts"
      ],
      "title": "CandleFrame",
      "type": "object"
    },
    "CandleShadow": {
      "additionalProperties": false,
      "description": "Теневая разметка свечных паттернов (блок J, 2026-10-16) — В РЕШЕНИЯ НЕ ИДЕТ.\n\nГейт лестницы смотрит только candle_pattern (детектор его не заполняет), промпты\nScout/Trader это поле исключают (PROMPT_EXCLUDE). Зачем: замер 16.10 — доджи у\nэкстремума без контекста не лучше случайной свечи; сначала когорты «с паттерном /\nбез» по журналу, решение о гейте — отдельным коммитом с инвариантом (ст. 5).",
      "properties": {
        "detector": {
          "title": "Detector",
          "type": "string"
        },
        "frames": {
          "additionalProperties": {
            "$ref": "#/$defs/CandleFrame"
          },
          "propertyNames": {
            "enum": [
              "1m",
              "5m",
              "15m",
              "1h",
              "4h",
              "1d"
            ]
          },
          "title": "Frames",
          "type": "object"
        }
      },
      "required": [
        "detector",
        "frames"
      ],
      "title": "CandleShadow",
      "type": "object"
    },
    "FvgInfo": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "title": "Bottom",
          "type": "number"
        },
        "mitigated": {
          "title": "Mitigated",
          "type": "boolean"
        },
        "timeframe": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "1h",
            "4h",
            "1d"
          ],
          "title": "Timeframe",
          "type": "string"
        },
        "top": {
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "top",
        "bottom",
        "mitigated",
        "timeframe"
      ],
      "title": "FvgInfo",
      "type": "object"
    },
    "ObInfo": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "title": "Bottom",
          "type": "number"
        },
        "tested": {
          "title": "Tested",
          "type": "boolean"
        },
        "timeframe": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "1h",
            "4h",
            "1d"
          ],
          "title": "Timeframe",
          "type": "string"
        },
        "top": {
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "top",
        "bottom",
        "tested",
        "timeframe"
      ],
      "title": "ObInfo",
      "type": "object"
    },
    "PriceOption": {
      "additionalProperties": false,
      "description": "Одна опция entry/SL/TP, порожденная детекторами. Trader выбирает по id.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "price": {
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "price"
      ],
      "title": "PriceOption",
      "type": "object"
    },
    "SetupFeatures": {
      "additionalProperties": false,
      "properties": {
        "atr_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atr Pct"
        },
        "candle_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candle Pattern"
        },
        "candle_patterns_shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandleShadow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fvg": {
          "anyOf": [
            {
              "$ref": "#/$defs/FvgInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ob": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rsi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsi"
        },
        "swept_liquidity": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Swept Liquidity"
        },
        "trend_mtf": {
          "anyOf": [
            {
              "enum": [
                "bullish",
                "bearish",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend Mtf"
        }
      },
      "title": "SetupFeatures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Кандидат сетапа от детерминированного ядра. Вход Scout'а.\n\nv2 (блок J, 2026-10-16): features.candle_patterns_shadow — теневая разметка свечей.",
  "properties": {
    "detector_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Detector Versions",
      "type": "object"
    },
    "direction": {
      "enum": [
        "long",
        "short"
      ],
      "title": "Direction",
      "type": "string"
    },
    "entry_options": {
      "items": {
        "$ref": "#/$defs/PriceOption"
      },
      "minItems": 1,
      "title": "Entry Options",
      "type": "array"
    },
    "features": {
      "$ref": "#/$defs/SetupFeatures"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "setup_type": {
      "enum": [
        "fvg",
        "ob",
        "liquidity_sweep",
        "bos",
        "choch",
        "confluence"
      ],
      "title": "Setup Type",
      "type": "string"
    },
    "sl_options": {
      "items": {
        "$ref": "#/$defs/PriceOption"
      },
      "minItems": 1,
      "title": "Sl Options",
      "type": "array"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "tp_options": {
      "items": {
        "$ref": "#/$defs/PriceOption"
      },
      "minItems": 1,
      "title": "Tp Options",
      "type": "array"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "id",
    "ts",
    "symbol",
    "direction",
    "setup_type",
    "timeframe",
    "score",
    "features",
    "entry_options",
    "sl_options",
    "tp_options"
  ],
  "title": "SetupCandidate",
  "type": "object"
}
